-- Exact physics modification logic from your original script
local function ApplyPhysicsWeight(massValue)
    local character = LocalPlayer.Character
    if not character then return end
    local root = character:WaitForChild("HumanoidRootPart", 5)
    if not root then return end

    local existing = character:FindFirstChild(WeightName)
    if existing then existing:Destroy() end

    if massValue > 0 then
        local weight = Instance.new("Part")
        weight.Name = WeightName
        weight.Size = Vector3.new(1, 1, 1)
        weight.Transparency = 1
        weight.CanCollide = false
        weight.CanQuery = false
        weight.Parent = character

        local weld = Instance.new("Weld")
        weld.Part0, weld.Part1, weld.C0, weld.Parent = root, weight, CFrame.new(OffsetAmount), weight
        
        weight.Massless = false
        weight.CustomPhysicalProperties = PhysicalProperties.new(massValue, 0.3, 0.5)
    end
end

local function UpdateWeightValues(newValue)
    CurrentWeight = math.clamp(newValue, 0, MaxLimit)
    NumberInput.Text = tostring(math.floor(CurrentWeight * 10) / 10)
    local Percent = CurrentWeight / MaxLimit
    SliderFill.Size = UDim2.new(Percent, 0, 1, 0)
    SliderButton.Position = UDim2.new(Percent, -8, 0.5, -8)
    ApplyPhysicsWeight(CurrentWeight)
end

local Dragging = false
SliderButton.MouseButton1Down:Connect(function() Dragging = true end)
UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then Dragging = false end end)

RunService.RenderStepped:Connect(function()
    if Dragging then
        local MousePos = UserInputService:GetMouseLocation().X
        local Percent = math.clamp((MousePos - SliderBackground.AbsolutePosition.X) / SliderBackground.AbsoluteSize.X, 0, 1)
        UpdateWeightValues(Percent * MaxLimit)
    end
end)

NumberInput.FocusLost:Connect(function()
    local n = tonumber(NumberInput.Text)
    if n then UpdateWeightValues(n) else NumberInput.Text = tostring(CurrentWeight) end
end)

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    if CurrentWeight > 0 then ApplyPhysicsWeight(CurrentWeight) end
end)

