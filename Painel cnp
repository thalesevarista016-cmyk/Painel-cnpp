local soundGun = false
local soundConnections = {}
local gunSound

local function configurarSoundGun(char)

	if not soundGun then
		return
	end

	local humanoid =
		char:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return
	end

	local connection =
		humanoid.AnimationPlayed:Connect(function(track)

			if not soundGun then
				return
			end

			local tool =
				char:FindFirstChildOfClass("Tool")

			if tool and tool.Name == "Gun" then

				if gunSound then
					gunSound:Play()
				end
			end
		end)

	table.insert(
		soundConnections,
		connection
	)
end

BtnSoundGun.MouseButton1Click:Connect(function()

	soundGun = not soundGun

	if soundGun then

		BtnSoundGun.Text =
			"Sound Gun: Ativado"

		BtnSoundGun.BackgroundColor3 =
			VERDE

		gunSound =
			Instance.new("Sound")

		gunSound.Name =
			"CNPSoundGun"

		gunSound.SoundId =
			"rbxassetid://6968135315"

		gunSound.Volume = 1
		gunSound.Parent = SoundService

		if Player.Character then
			configurarSoundGun(
				Player.Character
			)
		end

	else

		BtnSoundGun.Text =
			"Sound Gun: Desativado"

		BtnSoundGun.BackgroundColor3 =
			ROSA

		for _,con in ipairs(soundConnections) do
			pcall(function()
				con:Disconnect()
			end)
		end

		table.clear(soundConnections)

		if gunSound then
			gunSound:Destroy()
			gunSound = nil
		end
	end
end)

Player.CharacterAdded:Connect(function(char)

	task.wait(.2)

	if soundGun then
		configurarSoundGun(char)
	end
end)

