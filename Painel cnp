local speedEnabled = false
local speedConnections = {}
local speedCharacterConnection

local function limparSpeed()

	for _,con in ipairs(speedConnections) do
		pcall(function()
			con:Disconnect()
		end)
	end

	table.clear(speedConnections)

	local char = Player.Character

	if char then

		local part =
			char:FindFirstChild("GlitchPart")

		if part then
			part:Destroy()
		end
	end
end

local function iniciarSpeed(char)

	if not speedEnabled then
		return
	end

	limparSpeed()

	local humanoid =
		char:WaitForChild("Humanoid",5)

	local root =
		char:WaitForChild("HumanoidRootPart",5)

	if not humanoid or not root then
		return
	end

	local part = Instance.new("Part")

	part.Name = "GlitchPart"
	part.Size = Vector3.new(2,2,2)
	part.Transparency = 1
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Parent = char

	local weld = Instance.new("Weld")

	weld.Part0 = root
	weld.Part1 = part
	weld.C0 = CFrame.new()
	weld.Parent = part

	local ativo = false
	local distancia = 0

	local connection =
		humanoid.AnimationPlayed:Connect(function(track)

			if not track.Animation then
				return
			end

			local id =
				track.Animation.AnimationId

			if id == "rbxassetid://15609995579"
			or id == "http://www.roblox.com/asset/?id=15609995579" then

				ativo = true
				distancia = 7.5

			elseif id ==
				"rbxassetid://107481557610007" then

				ativo = true
				distancia = 10.5
			end

			track.Stopped:Connect(function()

				ativo = false
				weld.C0 = CFrame.new()

			end)
		end)

	table.insert(
		speedConnections,
		connection
	)

	local render =
		RunService.RenderStepped:Connect(function()

			if ativo and part.Parent then

				weld.C0 =
					CFrame.new(
						0,
						0,
						distancia
					)
			end
		end)

	table.insert(
		speedConnections,
		render
	)
end

BtnSpeed.MouseButton1Click:Connect(function()

	speedEnabled = not speedEnabled

	if speedEnabled then

		BtnSpeed.Text =
			"Speed: Ativado"

		BtnSpeed.BackgroundColor3 =
			VERDE

		if Player.Character then
			iniciarSpeed(Player.Character)
		end

		if speedCharacterConnection then
			speedCharacterConnection:Disconnect()
		end

		speedCharacterConnection =
			Player.CharacterAdded:Connect(function(char)

				task.wait(.2)

				if speedEnabled then
					iniciarSpeed(char)
				end
			end)

	else

		BtnSpeed.Text =
			"Speed: Desativado"

		BtnSpeed.BackgroundColor3 =
			ROSA

		if speedCharacterConnection then
			speedCharacterConnection:Disconnect()
			speedCharacterConnection = nil
		end

		limparSpeed()
	end
end)

