local bombaGold = false
local goldHumanoid
local goldRoot
local goldHolding = false
local goldTool
local goldLastJump = 0

local GOLD_COOLDOWN = 0.18
local GOLD_NAME = "gold c4 bomb"

local function criarGold()

	local tool = Instance.new("Tool")

	tool.Name = GOLD_NAME
	tool.RequiresHandle = true
	tool.CanBeDropped = false
	tool.ToolTip = "Pule quantas vezes quiser"

	local handle = Instance.new("Part")

	handle.Name = "Handle"
	handle.Size =
		Vector3.new(1.3,1.3,1.3)

	handle.BrickColor =
		BrickColor.new("Gold")

	handle.Material =
		Enum.Material.Neon

	handle.CanCollide = false
	handle.Parent = tool

	tool.Equipped:Connect(function()

		if bombaGold then

			goldHolding = true
			goldTool = tool
		end
	end)

	tool.Unequipped:Connect(function()
		goldHolding = false
	end)

	return tool
end

local function garantirGold()

	if not bombaGold then
		return
	end

	for _,item in ipairs(
		Player.Backpack:GetChildren()
	) do

		if item.Name == GOLD_NAME then
			item:Destroy()
		end
	end

	if Player.Character then

		for _,item in ipairs(
			Player.Character:GetChildren()
		) do

			if item.Name == GOLD_NAME then
				item:Destroy()
			end
		end
	end

	local tool = criarGold()

	tool.Parent =
		Player.Backpack

	goldTool = tool
end

